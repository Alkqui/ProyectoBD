# Selector del motor de base de datos ('postgresql' o 'sqlserver')
MOTOR_BD=postgresql

# Configuración de la base de datos (compartida / general)
DATABASE_NAME=centro_idiomas

# Configuración para PostgreSQL (MOTOR_BD=postgresql)
HOST=localhost
PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres@

# Configuración para SQL Server (MOTOR_BD=sqlserver)
SERVER=localhost
DB_USER=sa
DB_PASSWORD=Pleyades1@